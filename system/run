#!/usr/bin/env python3
"""Screening alert review.

    system/run <data folder> <output file> [<explain file>]

Reads only the data folder and writes one JSON line per hit. With a third argument (or
the SCREENING_EXPLAIN environment variable) it also writes an explain file showing what
each optional layer found. Python 3 standard library only.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from screening.pipeline import run  # noqa: E402


def main(argv):
    if len(argv) not in (3, 4):
        sys.stderr.write("usage: system/run <data folder> <output file> [<explain file>]\n")
        return 2
    explain = argv[3] if len(argv) == 4 else os.environ.get("SCREENING_EXPLAIN") or None
    run(argv[1], argv[2], explain)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
