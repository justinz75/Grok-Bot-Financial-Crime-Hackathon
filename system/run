#!/usr/bin/env python3
"""Screening alert review.  Usage: system/run <data folder> <output file>

Reads only the data folder, writes one JSON line per hit. Python 3 standard library only.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from screening.pipeline import run  # noqa: E402


def main(argv):
    if len(argv) != 3:
        sys.stderr.write("usage: system/run <data folder> <output file>\n")
        return 2
    folder, output = argv[1], argv[2]
    parent = os.path.dirname(os.path.abspath(output))
    if not os.path.isdir(parent):
        os.makedirs(parent)
    run(folder, output)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
